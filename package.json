{
  "name": "dual-agent-orchestrator",
  "displayName": "Dual Agent Orchestrator",
  "description": "Claude answers and Codex checks the answer: a chat where two coding agents review each other, with attachments, cited web research, isolated edits you review and apply, and token usage.",
  "version": "2.3.0",
  "private": true,
  "publisher": "NileshRavishan",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1b1c2b",
    "theme": "dark"
  },
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/RavishanBBN/Dual-Agent-VS-Code-Orchestrator.git"
  },
  "bugs": {
    "url": "https://github.com/RavishanBBN/Dual-Agent-VS-Code-Orchestrator/issues"
  },
  "homepage": "https://github.com/RavishanBBN/Dual-Agent-VS-Code-Orchestrator#readme",
  "engines": {
    "vscode": "^1.105.0",
    "node": ">=20"
  },
  "categories": [
    "AI",
    "Chat",
    "Machine Learning"
  ],
  "keywords": [
    "claude",
    "claude code",
    "codex",
    "ai",
    "agents",
    "multi-agent",
    "code review",
    "chat",
    "research",
    "llm"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Dual Agent launches local agent CLIs with workspace access, so it runs only in trusted workspaces."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Agents and Git need a local file system."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dualAgent",
          "title": "Dual Agent",
          "icon": "media/icon.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "dualAgentChat",
          "title": "Dual Agent",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "dualAgent": [
        {
          "id": "dualAgent.runs",
          "name": "Runs",
          "contextualTitle": "Dual Agent"
        },
        {
          "id": "dualAgent.agents",
          "name": "Agents",
          "contextualTitle": "Dual Agent",
          "visibility": "collapsed"
        }
      ],
      "dualAgentChat": [
        {
          "type": "webview",
          "id": "dualAgent.chat",
          "name": "Chat",
          "contextualTitle": "Dual Agent"
        }
      ]
    },
    "commands": [
      {
        "command": "dualAgent.openChat",
        "title": "Open Chat",
        "category": "Dual Agent",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "dualAgent.newConversation",
        "title": "New Conversation",
        "category": "Dual Agent",
        "icon": "$(add)",
        "enablement": "!dualAgent.running"
      },
      {
        "command": "dualAgent.openChatInEditor",
        "title": "Open Chat in Editor",
        "category": "Dual Agent",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "dualAgent.showUsage",
        "title": "Show Token Usage",
        "category": "Dual Agent",
        "icon": "$(graph)"
      },
      {
        "command": "dualAgent.runImplementation",
        "title": "Start Implementation Run",
        "category": "Dual Agent",
        "icon": "$(play)",
        "enablement": "!dualAgent.running"
      },
      {
        "command": "dualAgent.runBrainstorming",
        "title": "Start Brainstorming Run",
        "category": "Dual Agent",
        "icon": "$(lightbulb)",
        "enablement": "!dualAgent.running"
      },
      {
        "command": "dualAgent.cancel",
        "title": "Cancel Run",
        "category": "Dual Agent",
        "icon": "$(debug-stop)"
      },
      {
        "command": "dualAgent.resumeRun",
        "title": "Resume Run",
        "category": "Dual Agent",
        "icon": "$(debug-continue)",
        "enablement": "!dualAgent.running"
      },
      {
        "command": "dualAgent.approvePlan",
        "title": "Approve Plan…",
        "category": "Dual Agent",
        "icon": "$(check)"
      },
      {
        "command": "dualAgent.rejectPlan",
        "title": "Reject Plan",
        "category": "Dual Agent",
        "icon": "$(close)"
      },
      {
        "command": "dualAgent.reviewChanges",
        "title": "Review Changes",
        "category": "Dual Agent",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "dualAgent.applyChanges",
        "title": "Apply Changes to Workspace",
        "category": "Dual Agent",
        "icon": "$(check-all)"
      },
      {
        "command": "dualAgent.discardChanges",
        "title": "Discard Changes",
        "category": "Dual Agent",
        "icon": "$(trash)"
      },
      {
        "command": "dualAgent.openWorktree",
        "title": "Open Worktree in New Window",
        "category": "Dual Agent",
        "icon": "$(folder-opened)"
      },
      {
        "command": "dualAgent.openReport",
        "title": "Open Run Report",
        "category": "Dual Agent",
        "icon": "$(book)"
      },
      {
        "command": "dualAgent.exportRun",
        "title": "Export Run Report…",
        "category": "Dual Agent",
        "icon": "$(save)"
      },
      {
        "command": "dualAgent.exportLatestRun",
        "title": "Export Latest Run Report…",
        "category": "Dual Agent",
        "icon": "$(save)"
      },
      {
        "command": "dualAgent.doctor",
        "title": "Check Agent Setup",
        "category": "Dual Agent",
        "icon": "$(pulse)"
      },
      {
        "command": "dualAgent.showOutput",
        "title": "Show Output",
        "category": "Dual Agent",
        "icon": "$(output)"
      },
      {
        "command": "dualAgent.refreshRuns",
        "title": "Refresh Runs",
        "category": "Dual Agent",
        "icon": "$(refresh)"
      },
      {
        "command": "dualAgent.clearHistory",
        "title": "Delete All History…",
        "category": "Dual Agent",
        "icon": "$(trash)",
        "enablement": "!dualAgent.running"
      },
      {
        "command": "dualAgent.openDocument",
        "title": "Open Run Document",
        "category": "Dual Agent"
      },
      {
        "command": "dualAgent.openChange",
        "title": "Open Change",
        "category": "Dual Agent"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dualAgent.newConversation",
          "when": "view == dualAgent.chat",
          "group": "navigation@1"
        },
        {
          "command": "dualAgent.openChatInEditor",
          "when": "view == dualAgent.chat",
          "group": "navigation@2"
        },
        {
          "command": "dualAgent.showUsage",
          "when": "view == dualAgent.chat",
          "group": "navigation@3"
        },
        {
          "command": "dualAgent.cancel",
          "when": "view == dualAgent.chat && dualAgent.running",
          "group": "navigation@0"
        },
        {
          "command": "dualAgent.cancel",
          "when": "view == dualAgent.runs && dualAgent.running",
          "group": "navigation@0"
        },
        {
          "command": "dualAgent.runImplementation",
          "when": "view == dualAgent.runs",
          "group": "navigation@1"
        },
        {
          "command": "dualAgent.runBrainstorming",
          "when": "view == dualAgent.runs",
          "group": "navigation@2"
        },
        {
          "command": "dualAgent.refreshRuns",
          "when": "view == dualAgent.runs",
          "group": "navigation@9"
        },
        {
          "command": "dualAgent.resumeRun",
          "when": "view == dualAgent.runs",
          "group": "1_run@1"
        },
        {
          "command": "dualAgent.showOutput",
          "when": "view == dualAgent.runs",
          "group": "2_output@1"
        },
        {
          "command": "dualAgent.exportLatestRun",
          "when": "view == dualAgent.runs",
          "group": "2_output@2"
        },
        {
          "command": "dualAgent.clearHistory",
          "when": "view == dualAgent.runs",
          "group": "3_history@1"
        },
        {
          "command": "dualAgent.doctor",
          "when": "view == dualAgent.agents",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "dualAgent.approvePlan",
          "when": "view == dualAgent.runs && viewItem =~ /\\bawaitingApproval\\b/",
          "group": "inline@1"
        },
        {
          "command": "dualAgent.rejectPlan",
          "when": "view == dualAgent.runs && viewItem =~ /\\bawaitingApproval\\b/",
          "group": "inline@2"
        },
        {
          "command": "dualAgent.cancel",
          "when": "view == dualAgent.runs && viewItem =~ /\\bactive\\b/",
          "group": "inline@3"
        },
        {
          "command": "dualAgent.resumeRun",
          "when": "view == dualAgent.runs && viewItem =~ /\\bresumable\\b/",
          "group": "inline@4"
        },
        {
          "command": "dualAgent.reviewChanges",
          "when": "view == dualAgent.runs && viewItem =~ /\\bworktree\\b/",
          "group": "inline@5"
        },
        {
          "command": "dualAgent.reviewChanges",
          "when": "view == dualAgent.runs && viewItem == changes",
          "group": "inline@1"
        },
        {
          "command": "dualAgent.applyChanges",
          "when": "view == dualAgent.runs && viewItem == changes",
          "group": "inline@2"
        },
        {
          "command": "dualAgent.openReport",
          "when": "view == dualAgent.runs && viewItem =~ /\\brun\\b/",
          "group": "1_open@1"
        },
        {
          "command": "dualAgent.exportRun",
          "when": "view == dualAgent.runs && viewItem =~ /\\brun\\b/",
          "group": "1_open@2"
        },
        {
          "command": "dualAgent.reviewChanges",
          "when": "view == dualAgent.runs && viewItem =~ /\\bworktree\\b/",
          "group": "2_changes@1"
        },
        {
          "command": "dualAgent.applyChanges",
          "when": "view == dualAgent.runs && viewItem =~ /\\bworktree\\b/",
          "group": "2_changes@2"
        },
        {
          "command": "dualAgent.discardChanges",
          "when": "view == dualAgent.runs && viewItem =~ /\\bworktree\\b/",
          "group": "2_changes@3"
        },
        {
          "command": "dualAgent.openWorktree",
          "when": "view == dualAgent.runs && viewItem =~ /\\bworktree\\b/",
          "group": "2_changes@4"
        },
        {
          "command": "dualAgent.resumeRun",
          "when": "view == dualAgent.runs && viewItem =~ /\\bresumable\\b/",
          "group": "3_run@1"
        },
        {
          "command": "dualAgent.approvePlan",
          "when": "view == dualAgent.runs && viewItem =~ /\\bawaitingApproval\\b/",
          "group": "3_run@2"
        },
        {
          "command": "dualAgent.cancel",
          "when": "view == dualAgent.runs && viewItem =~ /\\bactive\\b/",
          "group": "3_run@3"
        }
      ],
      "commandPalette": [
        {
          "command": "dualAgent.cancel",
          "when": "dualAgent.running"
        },
        {
          "command": "dualAgent.approvePlan",
          "when": "dualAgent.awaitingApproval"
        },
        {
          "command": "dualAgent.rejectPlan",
          "when": "dualAgent.awaitingApproval"
        },
        {
          "command": "dualAgent.openDocument",
          "when": "false"
        },
        {
          "command": "dualAgent.openChange",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "dualAgent.openChatInEditor",
          "group": "navigation@100",
          "when": "activeWebviewPanelId != 'dualAgent.chatPanel'"
        }
      ]
    },
    "configuration": {
      "title": "Dual Agent Orchestrator",
      "properties": {
        "dualAgent.codex.command": {
          "type": "string",
          "default": "codex",
          "scope": "machine",
          "description": "Codex CLI command name or absolute path. Machine-scoped, and never resolved from the workspace folder or its worktree."
        },
        "dualAgent.claude.command": {
          "type": "string",
          "default": "claude",
          "scope": "machine",
          "description": "Claude Code CLI command name or absolute path. Machine-scoped, and never resolved from the workspace folder or its worktree."
        },
        "dualAgent.billingMode": {
          "type": "string",
          "enum": [
            "subscription",
            "environment"
          ],
          "default": "subscription",
          "scope": "machine",
          "enumDescriptions": [
            "Remove API-key, auth-token, alternate-endpoint, and Bedrock/Vertex routing variables from child processes and use saved CLI sign-in.",
            "Pass those variables through to child processes. This may incur API charges."
          ],
          "description": "Controls which credentials child agent processes can use."
        },
        "dualAgent.timeoutMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 180,
          "description": "Maximum duration for each workflow stage.",
          "scope": "machine"
        },
        "dualAgent.claude.maxTurns": {
          "type": "number",
          "default": 24,
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum agentic turns for each Claude stage.",
          "scope": "machine"
        },
        "dualAgent.claude.model": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional Claude model alias or ID. Empty uses the CLI/account default."
        },
        "dualAgent.codex.model": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional Codex model ID. Empty uses the CLI/account default."
        },
        "dualAgent.codex.effort": {
          "type": "string",
          "enum": [
            "",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ],
          "default": "",
          "scope": "machine",
          "description": "Default Codex reasoning effort (model_reasoning_effort). Empty uses the CLI default; not every model accepts every level."
        },
        "dualAgent.context.maxCharacters": {
          "type": "number",
          "default": 90000,
          "minimum": 10000,
          "maximum": 300000,
          "description": "Maximum normalized shared context included in a stage prompt.",
          "scope": "machine"
        },
        "dualAgent.fallbackOnQuota": {
          "type": "boolean",
          "default": true,
          "description": "When an agent reports a usage limit or is unavailable, let the other agent do its stages until the limit resets. The limited agent rejoins, and catches up on what it missed, once its limit resets.",
          "scope": "machine"
        },
        "dualAgent.limits.autoContinue": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "When both agents are at their usage limits, continue the stopped message or run automatically shortly after the first limit resets, and then run any queued messages. A run that edits files continues on its own only if `#dualAgent.isolation.setupCommands#` and `#dualAgent.verification.commands#` are unchanged since you allowed it; otherwise it waits for you."
        },
        "dualAgent.history.maxRuns": {
          "type": "number",
          "default": 100,
          "minimum": 5,
          "maximum": 500,
          "description": "Maximum number of workflow records retained in private workspace storage.",
          "scope": "machine"
        },
        "dualAgent.claude.allowedTools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "markdownDescription": "Claude Code permission rules granted to workspace-write stages only, for example `Bash(npm test:*)`. Claude stages have no shell unless a rule here names one: each rule makes its tool available and pre-approves the matching commands. Each rule lets agents run that command against files they wrote."
        },
        "dualAgent.environment.passthrough": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "markdownDescription": "Extra environment variable names passed to agent processes. By default only an allowlist (PATH, home and temp locations, locale, proxy and TLS settings) is passed so tokens and cloud credentials stay out of reach. In `subscription` billing mode, API-key and endpoint variables are removed even if listed here."
        },
        "dualAgent.isolation.mode": {
          "type": "string",
          "enum": [
            "worktree",
            "none"
          ],
          "default": "worktree",
          "scope": "machine",
          "enumDescriptions": [
            "Implementation runs edit an isolated Git worktree in private storage. You review the diff and apply or discard it when the run ends.",
            "Implementation runs edit the workspace directly, as in 1.x."
          ],
          "markdownDescription": "Where implementation runs edit files. The worktree contains tracked files plus your uncommitted and untracked changes, but not ignored files such as `node_modules` or `.env`; use `#dualAgent.isolation.setupCommands#` to install dependencies there."
        },
        "dualAgent.isolation.setupCommands": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "default": [],
          "scope": "machine",
          "markdownDescription": "Commands run once in a new worktree before the first stage, each as an argument list without a shell, for example `[[\"npm\", \"ci\"]]`. They run repository code with your permissions, outside any agent sandbox, and are listed in the consent prompt."
        },
        "dualAgent.verification.commands": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "default": [],
          "scope": "machine",
          "markdownDescription": "Commands the extension runs after every editing stage, each as an argument list without a shell, for example `[[\"npm\", \"test\"]]`. Their exit codes and output are given to the next reviewer as evidence, and a failure keeps the final gate from passing. They execute code the agents may have changed, with your permissions and outside any agent sandbox, and are listed in the consent prompt. Executables are never taken from the workspace, so use a command on `PATH` such as `npm` or `npx`."
        },
        "dualAgent.verification.timeoutMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 120,
          "scope": "machine",
          "description": "Maximum duration of each setup or verification command."
        },
        "dualAgent.workflow.maxFixRounds": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 3,
          "scope": "machine",
          "markdownDescription": "How many times Claude may fix the result after the final verification fails (a \"fail\" verdict, no readable verdict, or a failing verification command). Each round adds a Claude fix stage and a fresh Codex verification. When rounds run out the run ends as \"completed with unresolved findings\"."
        },
        "dualAgent.workflow.approvePlan": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "Pause implementation runs after Codex reviews Claude's plan, so you can approve, add guidance, or reject it before any file is edited."
        },
        "dualAgent.claude.resumeSessions": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "Continue Claude's previous session in later Claude stages of the same run, so its earlier exploration and output are not sent again. A session that cannot be resumed is replaced by a new one automatically."
        },
        "dualAgent.claude.effort": {
          "type": "string",
          "enum": [
            "",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "",
          "scope": "machine",
          "description": "Default Claude reasoning effort for new chat messages and workflows. Empty uses the CLI default; the chat can change it per message."
        },
        "dualAgent.privacy.redactSecrets": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "Mask API keys, tokens, and private keys (AWS, GitHub, OpenAI, Anthropic, Google, Slack, Stripe, npm, Azure, JWTs, PEM keys) in the diffs, files, attachments, history, and check output the extension puts into prompts, and in the output log. Agents can still open files themselves."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "dualAgent.runs",
        "contents": "Talk to Claude and Codex in the chat on the right-hand side bar.\n[Open Chat](command:dualAgent.openChat)\nClaude plans and implements, Codex reviews independently, and you approve the plan and the final diff.\n[Start Implementation Run](command:dualAgent.runImplementation)\n[Start Brainstorming Run](command:dualAgent.runBrainstorming)\nBoth CLIs must be installed and signed in. [Check Agent Setup](command:dualAgent.doctor)",
        "when": "workspaceFolderCount > 0"
      },
      {
        "view": "dualAgent.runs",
        "contents": "Open a folder to run agents in it.\n[Open Folder](command:workbench.action.files.openFolder)",
        "when": "workspaceFolderCount == 0"
      }
    ],
    "keybindings": [
      {
        "command": "dualAgent.openChat",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d"
      }
    ],
    "walkthroughs": [
      {
        "id": "getStarted",
        "title": "Get started with Dual Agent",
        "description": "Set up both CLIs, then let Claude answer and Codex check the answer.",
        "steps": [
          {
            "id": "setup",
            "title": "Install and sign in to both CLIs",
            "description": "Dual Agent drives the Claude Code and Codex CLIs you already use, with their saved sign-in.\n[Check Agent Setup](command:dualAgent.doctor)",
            "media": {
              "markdown": "media/walkthrough/setup.md"
            },
            "completionEvents": [
              "onCommand:dualAgent.doctor"
            ]
          },
          {
            "id": "chat",
            "title": "Open the chat",
            "description": "The chat lives in the secondary side bar, like Claude Code. Ask about the open folder; Claude answers and Codex checks the answer.\n[Open Chat](command:dualAgent.openChat)",
            "media": {
              "markdown": "media/walkthrough/chat.md"
            },
            "completionEvents": [
              "onCommand:dualAgent.openChat",
              "onView:dualAgent.chat"
            ]
          },
          {
            "id": "modes",
            "title": "Pick a mode",
            "description": "Chat, Research, Edit, Brainstorm, or Implement. Choose models and effort per agent from the pills under the message box.\n[Open Chat](command:dualAgent.openChat)",
            "media": {
              "markdown": "media/walkthrough/modes.md"
            }
          },
          {
            "id": "checks",
            "title": "Run your checks after every edit",
            "description": "Give the extension your test command, so every edit is verified and the result is evidence for the reviewer.\n[Configure Checks](command:workbench.action.openSettings?%5B%22dualAgent.verification.commands%22%5D)",
            "media": {
              "markdown": "media/walkthrough/checks.md"
            }
          },
          {
            "id": "review",
            "title": "Review and apply",
            "description": "Edits happen in an isolated copy. Nothing reaches your files until you review the diff and apply it.\n[Show Token Usage](command:dualAgent.showUsage)",
            "media": {
              "markdown": "media/walkthrough/review.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "watch": "node ./scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "smoke": "npm run build && node ./scripts/smoke.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "package": "npm run check && vsce package --no-dependencies",
    "screenshots": "npm run build && node ./scripts/screenshots.mjs"
  },
  "dependencies": {
    "cross-spawn": "7.0.6",
    "fflate": "0.8.3",
    "markdown-it": "15.0.3",
    "preact": "11.0.1",
    "unpdf": "1.8.1"
  },
  "overrides": {
    "@azure/msal-node": "7.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.18.0",
    "@types/vscode": "^1.105.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vscode/vsce": "4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.38.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^5.0.5"
  }
}
